From 3dbde28d80295ee94e8bc3372fe392bacf1d45f9 Mon Sep 17 00:00:00 2001
From: Armin Ronacher <armin@earendil.com>
Date: Wed, 7 Oct 2026 18:03:54 +0200
Subject: [PATCH] Add player.setTheme() for runtime theme changes, with up to
 256 colors

---
 index.d.ts                 |  9 +++++++++
 src/components/Player.js   |  4 +++-
 src/components/Terminal.js | 40 ++++++++++++++++++++++++++++++--------
 src/index.js               |  3 ++-
 src/ui.js                  |  3 ++-
 src/view.js                | 36 +++++++++++++++++++++++++++++++++-
 6 files changed, 83 insertions(+), 12 deletions(-)

diff --git a/index.d.ts b/index.d.ts
index 9bf29a9..95fd154 100644
--- a/index.d.ts
+++ b/index.d.ts
@@ -95,6 +95,13 @@ export interface MarkerEvent {
   label: string;
 }
 
+export interface Theme {
+  foreground: string;
+  background: string;
+  /** Hex colors: the 16 base colors, optionally followed by the rest of the 256-color palette. */
+  palette: string[];
+}
+
 export interface Player {
   el: HTMLElement;
   dispose(): void;
@@ -103,6 +110,8 @@ export interface Player {
   play(): Promise<boolean | void>;
   pause(): Promise<boolean | void>;
   seek(location: SeekLocation): Promise<boolean | void>;
+  /** Recolor the terminal with a theme, or restore the CSS/embedded theme with null. */
+  setTheme(theme: Theme | null): void;
   addEventListener(
     eventName: "play" | "playing" | "pause" | "ended",
     handler: (this: Player) => void,
diff --git a/src/components/Player.js b/src/components/Player.js
index 62cc41d..cb745a4 100644
--- a/src/components/Player.js
+++ b/src/components/Player.js
@@ -478,6 +478,7 @@ export default (props) => {
   };
 
   const embeddedTheme = createMemo(() => (preferEmbeddedTheme ? originalTheme() : null));
+  const customTheme = () => props.customTheme?.() ?? null;
 
   const playerStyle = () => {
     const style = {};
@@ -505,7 +506,7 @@ export default (props) => {
       style["--term-font-family"] = props.terminalFontFamily;
     }
 
-    const themeColors = embeddedTheme();
+    const themeColors = customTheme() ?? embeddedTheme();
 
     if (themeColors) {
       style["--term-color-foreground"] = themeColors.foreground;
@@ -570,6 +571,7 @@ export default (props) => {
           adaptivePalette={props.adaptivePalette}
           lineHeight={props.terminalLineHeight}
           preferEmbeddedTheme={preferEmbeddedTheme}
+          customTheme={customTheme()}
           core={core}
           logger={logger}
           onReady={props.onTerminalReady}
diff --git a/src/components/Terminal.js b/src/components/Terminal.js
index a88315c..e7d7d2a 100644
--- a/src/components/Terminal.js
+++ b/src/components/Terminal.js
@@ -107,6 +107,23 @@ export default (props) => {
     }
   });
 
+  // A theme set with player.setTheme() replaces the CSS and embedded themes and
+  // recolors the current frame right away. Clearing it restores them.
+  let embeddedTheme = null;
+
+  createEffect(() => {
+    const customTheme = props.customTheme;
+    pendingChanges.theme = customTheme ?? (props.preferEmbeddedTheme ? embeddedTheme : null);
+
+    if (vt !== undefined) {
+      for (let row = 0; row < size().rows; row++) {
+        pendingChanges.rows.add(row);
+      }
+    }
+
+    scheduleRender();
+  });
+
   createEffect(() => {
     cursorOn();
 
@@ -178,6 +195,7 @@ export default (props) => {
     }
 
     if (theme !== undefined && props.preferEmbeddedTheme) {
+      embeddedTheme = theme;
       pendingChanges.theme = theme;
 
       for (let row = 0; row < size().rows; row++) {
@@ -248,11 +266,8 @@ export default (props) => {
       }
 
       if (newTheme !== undefined) {
-        if (newTheme === null) {
-          setTheme(buildTheme(cssTheme, props.adaptivePalette));
-        } else {
-          setTheme(buildTheme(newTheme, props.adaptivePalette));
-        }
+        const effectiveTheme = props.customTheme ?? newTheme ?? cssTheme;
+        setTheme(buildTheme(effectiveTheme, props.adaptivePalette));
 
         colorsCache.clear();
       }
@@ -626,12 +641,21 @@ export default (props) => {
 };
 
 function buildTheme(theme, adaptivePalette = false) {
+  const base16 = theme.palette.slice(0, 16);
+
+  const palette = adaptivePalette
+    ? generate256Palette(base16, theme.background, theme.foreground)
+    : generateFixed256Palette(base16);
+
+  // Themes may define colors beyond the 16 base ones, up to all 256.
+  for (let i = 16; i < Math.min(theme.palette.length, 256); i++) {
+    if (theme.palette[i] !== undefined) palette[i] = theme.palette[i];
+  }
+
   return {
     fg: theme.foreground,
     bg: theme.background,
-    palette: adaptivePalette
-      ? generate256Palette(theme.palette, theme.background, theme.foreground)
-      : generateFixed256Palette(theme.palette),
+    palette,
   };
 }
 
diff --git a/src/index.js b/src/index.js
