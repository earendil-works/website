     seek: (pos) => core.seek(pos),
+    setTheme,
   };
 
   player.addEventListener = (name, callback) => {
diff --git a/src/ui.js b/src/ui.js
index 126af73..f4e41a7 100644
--- a/src/ui.js
+++ b/src/ui.js
@@ -7,7 +7,7 @@ function create(src, elem, workerUrl, opts = {}) {
   const coreLogger = opts.logger === console ? true : undefined;
   const uiLogger = opts.logger ?? new DummyLogger();
   const core = new CoreWorkerProxy(workerUrl, src, coreOpts(opts, { logger: coreLogger }), uiLogger);
-  const { el, dispose } = mount(
+  const { el, dispose, setTheme } = mount(
     core,
     elem,
     uiOpts(opts, {
@@ -27,6 +27,7 @@ function create(src, elem, workerUrl, opts = {}) {
     play: () => ready.then(core.play.bind(core)),
     pause: () => ready.then(core.pause.bind(core)),
     seek: (pos) => ready.then(() => core.seek(pos)),
+    setTheme,
   };
 
   player.addEventListener = (name, callback) => {
diff --git a/src/view.js b/src/view.js
index 1691fe7..96f029e 100644
--- a/src/view.js
+++ b/src/view.js
@@ -1,8 +1,11 @@
+import { createSignal } from "solid-js";
 import { render } from "solid-js/web";
 import Player from "./components/Player";
+import { normalizeHexColor } from "./colors.js";
 
 function mount(core, elem, opts = {}) {
   const metrics = measureTerminal(opts.terminalFontFamily, opts.terminalLineHeight);
+  const [customTheme, setCustomTheme] = createSignal(null);
 
   const props = {
     core: core,
@@ -21,6 +24,7 @@ function mount(core, elem, opts = {}) {
     terminalLineHeight: opts.terminalLineHeight,
     theme: opts.theme,
     onTerminalReady: opts.onTerminalReady,
+    customTheme,
     ...metrics,
   };
 
@@ -31,7 +35,37 @@ function mount(core, elem, opts = {}) {
     return el;
   }, elem);
 
-  return { el: el, dispose: dispose };
+  const setTheme = (theme) => setCustomTheme(normalizeTheme(theme));
+
+  return { el: el, dispose: dispose, setTheme };
+}
+
+// Validates a theme passed to player.setTheme(). The palette needs the 16
+// base colors and may define the rest of the 256-color palette.
+function normalizeTheme(theme) {
+  if (theme === null || theme === undefined) return null;
+
+  const foreground = normalizeHexColor(theme.foreground);
+  const background = normalizeHexColor(theme.background);
+  const palette = Array.isArray(theme.palette) ? theme.palette.slice(0, 256) : [];
+
+  if (foreground === undefined || background === undefined || palette.length < 16) {
+    throw new Error("setTheme: expected foreground, background and at least 16 palette colors");
+  }
+
+  return {
+    foreground,
+    background,
+    palette: palette.map((color, i) => {
+      const normalized = normalizeHexColor(color);
+
+      if (normalized === undefined && i < 16) {
+        throw new Error(`setTheme: invalid palette color ${i}: ${color}`);
+      }
+
+      return normalized;
+    }),
+  };
 }
 
 function measureTerminal(fontFamily, lineHeight) {
